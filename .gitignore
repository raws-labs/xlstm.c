# Ignore all dotfiles and dotfolders
.*

# But keep .gitignore itself
!.gitignore
!.github/

# Build artifacts
build/
*.o
*.a
*.so

# Test binaries
*_test

# Generated headers (TFLM integration test) - every .h there is emitted by
# generate_model.py at build time
test/adapters/tflm/*.h

# ESP-IDF project artifacts, if the esp-dl suite is built outside its image
sdkconfig
sdkconfig.old
managed_components/
dependencies.lock

# Python
__pycache__/
*.pyc
venv/

*.md
!README.md
!CONTRIBUTING.md
!.github/pull_request_template.md
