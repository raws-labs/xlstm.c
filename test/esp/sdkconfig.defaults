# Non-default settings the emulated ESP32-S3 gate needs. Each is here for a
# reason tied to this image's shape - four fused golden-vector suites in one
# firmware - not for tuning.

# The INT8 kernels put their accumulators on the stack, sized off
# XLSTM_MAX_HIDDEN (include/xlstm_simd.h, default 256): slstm_s8.c's
# int32_t acc_wx[4*H] and acc_ry[4*H] alone are ~8 KB there, before the rest
# of the call chain. IDF's 3584-byte default main-task stack panics before
# the first suite runs. XLSTM_MAX_HIDDEN itself is deliberately left alone -
# the point is to run the kernels as they ship.
CONFIG_ESP_MAIN_TASK_STACK_SIZE=65536

# Four suites back to back with no yield points, on an emulated core. The
# task watchdog's 5-second default fires and panics the system. This
# firmware never intends to feed it, so disable init rather than raise it.
CONFIG_ESP_TASK_WDT_INIT=n

# test/reference_data.h is several hundred KB of .rodata and every suite
# translation unit gets its own copy of what it names. The default
# single-app partition table caps the app at 1 MB, which this image exceeds.
CONFIG_PARTITION_TABLE_SINGLE_APP_LARGE=y

# Matches the --fill-flash-size the gate script pads the QEMU flash image to.
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y

# The gate reads the firmware's verdict off UART0. This is the IDF default
# for an S3 without a native-USB console, but set explicitly so the file
# says what the gate depends on instead of inheriting it.
CONFIG_ESP_CONSOLE_UART_DEFAULT=y
